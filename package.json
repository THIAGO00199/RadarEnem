{
  "name": "atena-edtech",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-atena.mjs && next dev",
    "build": "node scripts/build-atena.mjs",
    "preview": "python3 -m http.server 4173 --directory docs",
    "dev:pages": "node scripts/prepare-atena.mjs && next dev",
    "build:pages": "node scripts/build-atena.mjs",
    "preview:pages": "python3 -m http.server 4173 --directory docs",
    "data:update": "node scripts/update-data.mjs",
    "check:radar": "node scripts/check-radar.mjs",
    "typecheck": "tsc --noEmit",
    "check:hub": "node scripts/check-hub.mjs",
    "check:ui": "node scripts/check-ui.cjs",
    "build:materials": "node scripts/build-materials.mjs",
    "check:accessibility": "node scripts/check-accessibility.cjs",
    "check:performance": "node scripts/check-performance.cjs",
    "check:links": "node scripts/check-library-links.mjs",
    "check:insights": "node scripts/check-insights.mjs",
    "check:clarity": "node scripts/check-clarity.cjs",
    "check:essay": "node scripts/build-essay-ideas.mjs && node scripts/check-essay-ideas.mjs",
    "check:offline-app": "node scripts/check-essay-offline.cjs",
    "check:session": "node scripts/check-session.mjs",
    "check:experience": "node scripts/check-orbit.cjs",
    "data:update:python": "python3 backend/radar_collect.py",
    "check:atena": "node scripts/check-atena.mjs",
    "check:atena-ui": "node scripts/check-atena-ui.cjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "15.5.27",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0"
}
